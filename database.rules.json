{
  "rules": {
    ".read": false,
    ".write": false,

    "scadahub_admins": {
      ".read": true,
      ".write": false,
      "$uid": {
        ".validate": "newData.isBoolean()"
      }
    },

    "scadahub_users": {
      ".read": true,
      "$uid": {
        ".write": "root.child('scadahub_admins').child(auth.uid).val() === true || auth != null",
        ".validate": "newData.hasChildren(['uid', 'role', 'employeeId'])"
      }
    },

    "scadahub_employees": {
      ".read": true,
      ".write": true,
      "$empId": {
        ".validate": "newData.hasChildren(['id', 'name'])"
      }
    },

    "scadahub_schedules": {
      ".read": true,
      ".write": true
    },

    "scadahub_settings": {
      ".read": true,
      ".write": true
    },

    "scadahub_history": {
      ".read": true,
      ".write": true
    }
  }
}
